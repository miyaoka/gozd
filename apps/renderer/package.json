{
  "name": "@gozd/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "vue-tsc --noEmit",
    "lint": "eslint . && bun scripts/checkFeatureCycles.ts",
    "fix": "eslint . --fix -c eslint.config.fix.ts && oxfmt .",
    "fix:staged": "eslint --fix -c eslint.config.fix.ts --no-warn-ignored --cache",
    "test": "bun test",
    "test:browser": "vitest run",
    "test:browser:setup": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.0",
    "@dnd-kit/helpers": "0.5.0",
    "@dnd-kit/vue": "0.5.0",
    "@gozd/claude-session-log": "workspace:*",
    "@gozd/design-tokens": "workspace:*",
    "@gozd/rpc": "workspace:*",
    "@gozd/shared": "workspace:*",
    "@gozd/shiki-lang-map": "workspace:*",
    "@gozd/themes": "workspace:*",
    "@shikijs/monaco": "4.4.3",
    "@vueuse/core": "14.4.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.14",
    "marked": "18.0.10",
    "material-icon-theme": "5.37.0",
    "mermaid": "11.17.0",
    "monaco-editor": "0.56.0",
    "pinia": "4.0.3",
    "shiki": "4.4.3",
    "vue": "3.5.41"
  },
  "devDependencies": {
    "@gozd/eslint-plugin": "workspace:*",
    "@iconify-json/lucide": "1.2.125",
    "@iconify-json/mdi": "1.2.3",
    "@miyaoka/eslint-plugin-barrel-import": "0.0.0",
    "@miyaoka/vite-plugin-doc-block": "0.0.3",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@vitejs/plugin-vue": "6.0.8",
    "@vitest/browser-playwright": "4.1.11",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "dependency-cruiser": "18.2.0",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "4.7.0",
    "eslint-plugin-import-x": "catalog:",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vue": "10.10.0",
    "playwright": "1.62.1",
    "tailwindcss": "catalog:",
    "typescript": "catalog:",
    "unplugin-icons": "23.0.1",
    "vite": "catalog:",
    "vitest": "4.1.11",
    "vitest-browser-vue": "2.1.0",
    "vue-tsc": "3.3.11"
  }
}
