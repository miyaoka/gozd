{
  "name": "@gozd/renderer",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "typecheck": "tsrs --runExternalCode --noEmit --extendedDiagnostics",
    "lint": "bun lint --no-script --config eslint.config.ts --max-warnings 0 . && bun scripts/checkFeatureCycles.ts",
    "fix": "bun lint --no-script --config eslint.config.ts --fix .",
    "fix:staged": "bun lint --no-script --config eslint.config.ts --fix --no-warn-ignored --max-warnings 0",
    "test": "bun test",
    "test:browser": "vitest run",
    "test:browser:setup": "playwright install --only-shell chromium"
  },
  "dependencies": {
    "@dnd-kit/abstract": "0.5.3",
    "@dnd-kit/helpers": "0.5.3",
    "@dnd-kit/vue": "0.5.3",
    "@gozd/claude-session-log": "workspace:*",
    "@gozd/design-tokens": "workspace:*",
    "@gozd/rpc": "workspace:*",
    "@gozd/shared": "workspace:*",
    "@gozd/shiki-lang-map": "workspace:*",
    "@gozd/themes": "workspace:*",
    "@shikijs/monaco": "4.6.0",
    "@vueuse/core": "15.0.0",
    "@xterm/addon-fit": "0.11.0",
    "@xterm/addon-unicode11": "0.9.0",
    "@xterm/addon-web-links": "0.12.0",
    "@xterm/addon-webgl": "0.19.0",
    "@xterm/xterm": "6.0.0",
    "dompurify": "3.4.18",
    "marked": "18.2.1",
    "material-icon-theme": "5.40.0",
    "mermaid": "12.3.0",
    "monaco-editor": "0.57.0",
    "pinia": "4.1.0",
    "shiki": "4.6.0",
    "vue": "3.5.45"
  },
  "devDependencies": {
    "@gozd/eslint-plugin": "workspace:*",
    "@iconify-json/lucide": "1.2.157",
    "@iconify-json/mdi": "1.2.3",
    "@miyaoka/eslint-plugin-barrel-import": "0.1.0",
    "@tailwindcss/vite": "catalog:",
    "@types/bun": "catalog:",
    "@vitejs/plugin-vue": "6.0.11",
    "@vitest/browser-playwright": "5.1.0",
    "@vue/eslint-config-prettier": "10.2.0",
    "@vue/eslint-config-typescript": "14.9.0",
    "dependency-cruiser": "18.8.0",
    "eslint": "catalog:",
    "eslint-plugin-better-tailwindcss": "4.11.0",
    "eslint-plugin-unused-imports": "catalog:",
    "eslint-plugin-vue": "10.12.1",
    "playwright": "1.65.1",
    "tailwindcss": "catalog:",
    "tsrs": "0.25.0-ts7.1.0-beta",
    "typescript": "catalog:",
    "unplugin-icons": "24.0.0",
    "vite": "catalog:",
    "vitest": "5.1.0",
    "vitest-browser-vue": "3.1.0",
    "vize": "0.784.0"
  }
}
