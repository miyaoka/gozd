{
  "name": "gozd",
  "private": true,
  "description": "Gozd — Git Orchestrated Zone for Development. Desktop app for managing parallel AI agent development.",
  "author": "miyaoka",
  "type": "module",
  "scripts": {
    "dev": "bun scripts/dev.ts",
    "dev:prod": "rm -rf \"$TMPDIR/gozd-local-launch\" \"$TMPDIR/gozd-local.sock\" && env -u GOZD_SOCKET_PATH \"apps/electron/out/mac-arm64/Gozd Local.app/Contents/Resources/app/bin/gozd\"",
    "build:all": "pnpm -r --include-workspace-root --if-present run build",
    "build:app": "pnpm --filter @gozd/electron build:app",
    "open:app": "open \"apps/electron/out/mac-arm64/Gozd Local.app\"",
    "lint": "oxlint --type-aware --ignore-pattern 'apps/**' --ignore-pattern 'packages/**'",
    "fix": "oxfmt '!apps/**' '!packages/**'",
    "lint:all": "pnpm -r --include-workspace-root --if-present --no-bail --aggregate-output --reporter=append-only run lint",
    "fix:all": "pnpm -r --include-workspace-root --if-present --no-bail --aggregate-output --reporter=append-only run fix",
    "test": "bun test scripts",
    "test:all": "pnpm -r --include-workspace-root --if-present --no-bail --aggregate-output --reporter=append-only run test",
    "test:browser:all": "pnpm -r --include-workspace-root --if-present --no-bail --aggregate-output --reporter=append-only run test:browser",
    "typecheck:all": "pnpm -r --include-workspace-root --if-present run typecheck",
    "knip": "knip",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "concurrently": "10.0.5",
    "knip": "6.32.3",
    "lefthook": "catalog:",
    "oxfmt": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:"
  }
}
